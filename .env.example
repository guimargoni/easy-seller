NODE_ENV=development
ALLOW_LOCAL_IDENTITY=true
API_PORT=3333
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres@localhost:55432/easy_seller?schema=public
LOCAL_USER_EMAIL=local@easyseller.local
NEXT_PUBLIC_API_URL=http://localhost:3333
CATALOG_STORAGE_DIR=.runtime/catalogs
CATALOG_MAX_UPLOAD_BYTES=268435456
CATALOG_CONFIDENCE_THRESHOLD=0.75
CATALOG_WORKER_INTERVAL_MS=2000
CATALOG_OCR_LANGS=por+eng
CATALOG_OCR_LOG=false

# Fase 4 — Amazon Intelligence. A URL aponta para um gateway autenticado que assina
# chamadas oficiais SP-API (LWA + AWS SigV4); sem estas variáveis não há dado oficial.
AMAZON_SP_API_BASE_URL=
AMAZON_SP_API_ACCESS_TOKEN=
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
# Fallbacks são sempre devolvidos como ESTIMATED, nunca REAL.
AMAZON_ESTIMATED_REFERRAL_RATE=0.15
AMAZON_ESTIMATED_LOGISTICS_BRL=0
